{
  "title": "SecurePrompt Guard Overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["secure_prompt_guard", "ml"],
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "targets": [
        {
          "expr": "sum(rate(secure_prompt_guard_http_requests_total[5m])) by (status)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Latency Average",
      "targets": [
        {
          "expr": "sum(rate(secure_prompt_guard_http_request_duration_seconds_sum[5m])) / sum(rate(secure_prompt_guard_http_request_duration_seconds_count[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker Outcomes",
      "targets": [
        {
          "expr": "sum(rate(secure_prompt_guard_worker_outcomes_total[5m])) by (model_code, status, cache_hit)"
        }
      ]
    }
  ]
}
